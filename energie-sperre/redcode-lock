#!/usr/bin/env python3
"""redcode-lock: Bildschirm sperren MIT Sofort-Abdeckung.

dm-tool lock braucht ca. 7-10 s, bis der Sperrbildschirm da ist (zweiter Bildschirm-Server).
Damit es nicht schwarz wird, deckt dieses Programm den Bildschirm sofort mit dem roten
Code-Regen ab (Tastatur + Maus sind dabei abgefangen) und schliesst die Abdeckung, sobald
LightDM die Sitzung wirklich gesperrt hat (LockedHint=yes).

  redcode-lock                      sperren (Normalfall)
  REDCODE_COVER_ONLY=1 redcode-lock nur Abdeckung zeigen, ca. 4 s, NICHT sperren (zum Testen)
"""
import os, subprocess, sys, time
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

BG = "/usr/share/backgrounds/redcode/redcode.png"
SKULL = "/usr/share/backgrounds/redcode/skulls/4-code.png"
TEST = bool(os.environ.get("REDCODE_COVER_ONLY"))
MAX_SECONDS = 4 if TEST else 40
LOCKFILE = "/tmp/redcode-lock-%d.pid" % os.getuid()


def session_id():
    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        return sid
    out = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 4 and f[1] == str(os.getuid()) and f[3] == "seat0":
            return f[0]
    return None


def locked(sid):
    if not sid:
        return False
    r = subprocess.run(["loginctl", "show-session", sid, "-p", "LockedHint", "--value"], capture_output=True, text=True)
    return r.stdout.strip() == "yes"


def already_running():
    try:
        pid = int(open(LOCKFILE).read())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def main():
    if not TEST:
        sys.exit("redcode-lock ist abgeschaltet: dm-tool lock kann die Anmeldung haengen lassen. "
                 "Sperren jetzt mit: xflock4 (xfce4-screensaver). Test der Abdeckung: REDCODE_COVER_ONLY=1")
    if already_running():
        return
    with open(LOCKFILE, "w") as f:
        f.write(str(os.getpid()))
    sid = session_id()
    if not TEST:
        # Sperre sofort im Hintergrund anstossen
        subprocess.Popen(["dm-tool", "lock"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)

    win = Gtk.Window()
    win.set_decorated(False)
    win.set_keep_above(True)
    win.fullscreen()
    win.set_app_paintable(True)
    screen = Gdk.Screen.get_default()
    geo = screen.get_display().get_primary_monitor().get_geometry()
    W, H = geo.width, geo.height
    win.set_default_size(W, H)

    box = Gtk.Overlay()
    win.add(box)
    try:
        bg = GdkPixbuf.Pixbuf.new_from_file_at_scale(BG, W, H, False)
    except Exception:
        bg = None
    img = Gtk.Image.new_from_pixbuf(bg) if bg else Gtk.Image()
    box.add(img)

    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    try:
        sk = GdkPixbuf.Pixbuf.new_from_file_at_scale(SKULL, 170, 170, True)
        v.pack_start(Gtk.Image.new_from_pixbuf(sk), False, False, 0)
    except Exception:
        pass
    lab = Gtk.Label(label="Sperre wird geladen …")
    lab.set_name("cover-label")
    v.pack_start(lab, False, False, 0)
    box.add_overlay(v)

    css = Gtk.CssProvider()
    css.load_from_data(b"#cover-label { color: #ff5a5a; font-family: 'DejaVu Sans Mono'; font-size: 15px; }"
                       b" window { background: #060000; }")
    Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def hide_cursor(w, *_):
        gw = w.get_window()
        if gw:
            gw.set_cursor(Gdk.Cursor.new_for_display(gw.get_display(), Gdk.CursorType.BLANK_CURSOR))

    def grab(w, *_):
        try:
            seat = Gdk.Display.get_default().get_default_seat()
            seat.grab(w.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None)
        except Exception:
            pass

    win.connect("realize", hide_cursor)
    win.connect("map-event", lambda w, e: GLib.timeout_add(150, grab, w) and False)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()

    t0 = time.time()

    def check():
        elapsed = time.time() - t0
        if elapsed >= MAX_SECONDS or (not TEST and elapsed > 1.5 and locked(sid)):
            # Kurz warten, damit der Sperrbildschirm sicher vorn ist
            GLib.timeout_add(600 if not TEST else 0, win.destroy)
            return False
        return True

    GLib.timeout_add(300, check)
    try:
        Gtk.main()
    finally:
        try:
            os.remove(LOCKFILE)
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    main()
