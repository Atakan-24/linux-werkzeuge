    # ---------- Helfer zum Bauen der Seiten ----------
    def grid(self):
        g = Gtk.Grid(column_spacing=12, row_spacing=10, margin=14); g.row = 0; return g

    def mit_standard(self, widget):
        """Schieberegler/Zahlfeld mit „Standard: N“ und Zurück-Knopf umgeben (Wert in widget._standard)."""
        std = getattr(widget, "_standard", None)
        if std is None or not isinstance(widget, (Gtk.Scale, Gtk.SpinButton)):
            return widget
        std = int(std)
        box = Gtk.Box(spacing=8)
        widget.set_hexpand(True)
        box.pack_start(widget, True, True, 0)
        lab = Gtk.Label(label="Standard: %d" % std)
        lab.get_style_context().add_class("hint")
        btn = Gtk.Button(label="↺ Standard")
        btn.set_tooltip_text("Auf den Standardwert %d zurücksetzen" % std)
        btn.connect("clicked", lambda _b: widget.set_value(std))

        def sync(*_a):
            btn.set_sensitive(int(round(widget.get_value())) != std)
        widget.connect("value-changed", sync)
        sync()
        box.pack_start(lab, False, False, 0)
        box.pack_start(btn, False, False, 0)
        return box

    def row(self, g, label, widget, hint=None):
        widget = self.mit_standard(widget)
        l = Gtk.Label(label=label, xalign=0); g.attach(l, 0, g.row, 1, 1)
        widget.set_hexpand(True); g.attach(widget, 1, g.row, 1, 1); g.row += 1
        if hint:
            hl = Gtk.Label(label=hint, xalign=0); hl.get_style_context().add_class("hint"); g.attach(hl, 1, g.row, 1, 1); g.row += 1

    def scale(self, key, lo, hi, step=1):
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_value(self.c[key]); s.set_digits(0); s.set_value_pos(Gtk.PositionType.RIGHT)
        s.connect("value-changed", lambda w: self.set(key, int(w.get_value())))
        if isinstance(DEFAULTS.get(key), int) and not isinstance(DEFAULTS.get(key), bool):
            s._standard = DEFAULTS[key]
        self.w[key] = s
        if key == "fontSize":
            self.font_scales.append(s)
        return s

    def switch(self, key):
        s = Gtk.Switch(active=self.c[key], halign=Gtk.Align.START)
        s.connect("notify::active", lambda w, _: self.set(key, w.get_active())); self.w[key] = s; return s

    def combo(self, key, items):
        """items: Liste (wert, text)"""
        cb = Gtk.ComboBoxText()
        for v, t in items:
            cb.append(str(v), t)
        cb.set_active_id(str(self.c[key]))
        conv = type(items[0][0])
        cb.connect("changed", lambda w: w.get_active_id() is not None and self.set(key, conv(w.get_active_id())))
        self.w[key] = cb; return cb

    # ---------- Seiten ----------
    def page_font(self):
        g = self.grid()
