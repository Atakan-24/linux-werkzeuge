    def update_codex_preview(self):
        if not hasattr(self, "codex_preview_labels"):
            return
        top, left, bottom = (self.codex_hex(key) for key in ("theme", "left_color", "bottom_color"))
        bg = self.c["custom"]["bg"]; fg = self.c["custom"]["fg"]
        link = self.c["custom"]["ansi"][4]
        loc = self.codex_ui["locations"]
        for block, (tool, badge, key, chat_name) in enumerate((
                ("Codex", "Codex Chat", "codex_input", "Mein Chat"),
                ("Claude Code", "Claude Chat", "claude_input", "Mein Chat"))):
            typed = self.codex_ui.get(key) or fg
            answer = self.codex_ui.get(key.replace("_input", "_output")) or fg
            base = block * 4
            self.codex_preview_labels[base].set_markup(
                f'<span size="large" weight="bold">{tool}-Vorschau</span>')
            widgets = [(k, t) for k, t in (("model", "Modell " + tool), ("effort", "Denken hoch"),
                                           ("five", "5h 42%"), ("week", "Woche 21%"), ("cyber", "Vollzugriff"))
                       if self.codex_ui.get(k)]
            side = [t for k, t in widgets if loc.get(k) == "links"]
            foot = [t for k, t in widgets if loc.get(k) == "unten"]
            rows = [("CHATS", f'<span foreground="{left}" weight="bold">%s</span>'),
                    ("▶ " + chat_name, f'<span foreground="{left}">%s</span>'),
                    ("  Anderer Chat", f'<span foreground="{left}">%s</span>')]
            rows += [(t, f'<span foreground="{left}">%s</span>') for t in side]
            chat = [(f"❯ das tippst du", f'<span foreground="{typed}">%s</span>'),
                    ("", "%s"),
                    ("● Antwort von " + tool, f'<span foreground="{answer}">%s</span>'),
                    ("  https://beispiel.link", f'<span foreground="{link}">%s</span>'),
                    ("", "%s")]
            lines = []
            for n in range(max(len(rows), len(chat))):
                lt, lf = rows[n] if n < len(rows) else ("", "%s")
                ct, cf = chat[n] if n < len(chat) else ("", "%s")
                esc = lambda t: t.replace("&", "&amp;").replace("<", "&lt;")
                lines.append(lf % esc(lt.ljust(24)) + "│ " + cf % esc(ct))
            status = "   ".join(foot) or "(Status unten leer)"
            bar = (f'<span background="{top}" foreground="#1e1e2e" weight="bold"> {badge} </span> '
                   f'<span foreground="{bottom}">{status}</span>')
            self.codex_preview_labels[base + 1].set_markup(
                f'<span font_family="monospace" background="{bg}" foreground="{fg}">' + "\n".join(lines) + '</span>')
            self.codex_preview_labels[base + 2].set_markup(bar)
            self.codex_preview_labels[base + 3].set_text("")

    def page_hotkeys(self):
        grid = self.grid()
        intro = Gtk.Label(label="Kürzel anklicken und eintippen oder mit „Aufnehmen“ direkt drücken. "
                                "Eine Folge wie „^,1“ heißt: erst ^, dann 1 (innerhalb von 1,2 s). Leer = deaktiviert.", xalign=0)
        intro.set_line_wrap(True)
        grid.attach(intro, 0, grid.row, 2, 1); grid.row += 1
        self.build_key_test(grid)
        title = Gtk.Label(label="Terminal-Studio", xalign=0)
        title.get_style_context().add_class("title")
        grid.attach(title, 0, grid.row, 2, 1); grid.row += 1
        for action, label in STUDIO_HOTKEY_LABELS.items():
            self.hotkey_row(grid, label, "studioShortcuts", action)
        title = Gtk.Label(label="QTerminal – alle Aktionen", xalign=0)
        title.get_style_context().add_class("title")
        grid.attach(title, 0, grid.row, 2, 1); grid.row += 1
        for key in sorted(self.c["terminalShortcuts"], key=lambda x: unquote(x).lower()):
            self.hotkey_row(grid, unquote(key), "terminalShortcuts", key)
        self.mark_hotkey_conflicts()
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(grid)
        return scroll

    def hotkey_row(self, grid, label, group, action):
        entry = Gtk.Entry(text=self.c[group].get(action, ""))
        entry.set_width_chars(20)
        self.hotkey_entries[(group, action)] = (entry, label)

        def changed(widget):
            self.c[group][action] = widget.get_text().strip()
            self.mark_hotkey_conflicts()
        entry.connect("changed", changed)
        record = Gtk.Button(label="Aufnehmen")
        record.connect("clicked", self.record_hotkey, entry, group, action)
        reset = Gtk.Button(label="↺")
        reset.set_tooltip_text("Auf Standard zurücksetzen" if group == "studioShortcuts"
                               else "Auf den Wert von vorhin zurücksetzen")
        reset.connect("clicked", lambda _b: entry.set_text(self.hotkey_default(group, action)))
        row = Gtk.Box(spacing=6)
        row.pack_start(entry, True, True, 0)
        row.pack_start(record, False, False, 0)
        row.pack_start(reset, False, False, 0)
        self.row(grid, label, row)

    def record_hotkey(self, button, entry, group=None, action=None):
        self.finish_recording()
        single = group == "studioShortcuts" and action in ("copy", "paste")   # dort nur Einzeltasten
        self.recording_hotkey = {"button": button, "entry": entry, "first": None,
                                 "single": single, "timer": None}
        button.set_label("Taste drücken …")
        button.grab_focus()

    def record_step(self, hotkey):
        rec = self.recording_hotkey
        if rec["first"] is None:
            rec["first"] = hotkey
            if rec["single"]:
                self.finish_recording()
                return
            rec["button"].set_label(f"{hotkey} … weitere Taste? ({SEQUENCE_WINDOW:.1f} s)")
            rec["timer"] = GLib.timeout_add(int(SEQUENCE_WINDOW * 1000), lambda: self.finish_recording(True))
        else:
            rec["first"] = rec["first"] + "," + hotkey
            self.finish_recording()

    def finish_recording(self, from_timer=False):
        rec = self.recording_hotkey
        if not rec:
            return False
        self.recording_hotkey = None
        if rec["timer"] and not from_timer:
            GLib.source_remove(rec["timer"])
        if rec["first"]:
            rec["entry"].set_text(rec["first"])
        rec["button"].set_label("Aufnehmen")
        return False

    def hotkey_default(self, group, action):
        if group == "studioShortcuts":
            return DEFAULTS["studioShortcuts"].get(action, "")
        return self.hotkey_initial.get(action, "")

    def mark_hotkey_conflicts(self):
        seen = {}
        for (group, _action), (entry, label) in self.hotkey_entries.items():
            value = entry.get_text().strip()
            if value:
                seen.setdefault((group, value), []).append(label)
        for (group, _action), (entry, label) in self.hotkey_entries.items():
            value = entry.get_text().strip()
            others = [name for name in seen.get((group, value), []) if name != label] if value else []
            context = entry.get_style_context()
            (context.add_class if others else context.remove_class)("konflikt")
            entry.set_tooltip_text(("Schon belegt von: " + ", ".join(others)) if others else None)

    def describe_hotkey(self, text):
        treffer = []
        for action, value in self.c["studioShortcuts"].items():
            if value == text:
                treffer.append(f"{STUDIO_HOTKEY_LABELS.get(action, action)} (Studio)")
        for name, value in self.c["terminalShortcuts"].items():
            if value == text:
                treffer.append(f"{unquote(name)} (QTerminal)")
        teile = ["belegt von: " + ", ".join(treffer) if treffer else "frei"]
        steps = parse_binding(text)
        if len(steps) > 1:
            einzeln = [STUDIO_HOTKEY_LABELS.get(a, a) for a, v in self.c["studioShortcuts"].items() if v == steps[0]]
            if einzeln:
                teile.append(f"Achtung: {steps[0]} ist auch einzeln belegt ({', '.join(einzeln)})")
        if text in KEY_HINTS:
            teile.append(KEY_HINTS[text])
        return " · ".join(teile)

    def build_key_test(self, grid):
        self.test_entry = Gtk.Entry()
        self.test_entry.set_editable(False)
        self.test_entry.set_placeholder_text("Hier eine Taste oder Folge drücken …")
        self.test_entry.set_width_chars(24)
        self.test_result = Gtk.Label(label="", xalign=0)
        self.test_result.set_line_wrap(True)
        self.test_entry.connect("key-press-event", self.key_test_event)
        box = Gtk.Box(spacing=10)
        box.pack_start(self.test_entry, False, False, 0)
        box.pack_start(self.test_result, True, True, 0)
        self.row(grid, "Tastentest", box)

    def key_test_event(self, _widget, event):
        hotkey = self.event_hotkey(event)
        if not hotkey:
            return True
        now = time.monotonic()
        last = self.test_last
        text = f"{last[0]},{hotkey}" if last and now - last[1] <= SEQUENCE_WINDOW else hotkey
        self.test_last = (text if "," not in text else hotkey, now)
        self.test_entry.set_text(text)
        self.test_result.set_text(self.describe_hotkey(text))
        return True

    def show_sequence_hint(self, action):
        steps = parse_binding(self.c["studioShortcuts"].get(action))
        pending = self.sequences.pending
        naechste = steps[pending[1]] if pending and pending[1] < len(steps) else ""
        self.set_title(f"Terminal-Studio – {steps[0]} gedrückt · jetzt {naechste}: "
                       f"{STUDIO_HOTKEY_LABELS.get(action, action)}")
        if action == "close":
            self.get_style_context().add_class("close-pending")
        if self.hint_source:
            GLib.source_remove(self.hint_source)
        self.hint_source = GLib.timeout_add(int(SEQUENCE_WINDOW * 1000) + 100, self.hint_timeout)

    def hint_timeout(self):
        self.hint_source = None
        self.reset_sequence_hint()
        return False

    def clear_sequence_hint(self):
        if self.hint_source:
            GLib.source_remove(self.hint_source)
            self.hint_source = None
        self.reset_sequence_hint()

    def reset_sequence_hint(self):
        if self.get_title() != "Terminal-Studio":
            self.set_title("Terminal-Studio")
        self.get_style_context().remove_class("close-pending")

    def run_studio_action(self, action):
        if action == "close":
            self.confirm_close()
        elif action == "save":
            self.save(None, False)
        elif action == "test":
            self.save(None, True)
        elif action == "preview":
            self.open_large_banner_preview(None)

    def event_hotkey(self, event):
        key = Gdk.keyval_name(event.keyval) or ""
        aliases = {"Prior": "PgUp", "Next": "PgDown", "Page_Up": "PgUp", "Page_Down": "PgDown",
                   "Insert": "Ins", "Delete": "Del", "space": "Space", "plus": "+", "minus": "-",
                   "comma": "Comma", "dead_circumflex": "^", "asciicircum": "^"}
        key = aliases.get(key, key.upper() if len(key) == 1 else key)
        if key in ("Control_L", "Control_R", "Shift_L", "Shift_R", "Alt_L", "Alt_R", "Meta_L", "Meta_R"):
            return ""
        parts = []
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            parts.append("Ctrl")
        if event.state & Gdk.ModifierType.MOD1_MASK:
            parts.append("Alt")
        if event.state & Gdk.ModifierType.SHIFT_MASK:
            parts.append("Shift")
        if event.state & Gdk.ModifierType.SUPER_MASK:
            parts.append("Meta")
        return "+".join(parts + [key])

    def page_design(self):
        g = self.grid()
        self.design_cb = Gtk.ComboBoxText()
        for k, t in [("Red", "Rot-Schwarz (Hacker-Kali)"), ("Purple", "Lila"), ("Blue", "Blau"), ("Green", "Grün"),
                     ("Orange", "Orange"), ("Pink", "Pink"), ("Teal", "Türkis"), ("Yellow", "Gelb"), ("Slate", "Grau")]:
            self.design_cb.append(k, t)
        self.design_cb.set_active_id("Red")
        self.row(g, "Farbe für Fenster und Symbole", self.design_cb,
                 "Ändert Fenster, Symbole und Programm-Farben. Offene Programme übernehmen es nach dem Neustart.")
        ok = Gtk.Button(label="Design anwenden"); ok.get_style_context().add_class("save")
        ok.connect("clicked", self.design_run, "apply")
        back = Gtk.Button(label="Vorheriges Design wiederherstellen"); back.connect("clicked", self.design_run, "back")
        box = Gtk.Box(spacing=8); box.pack_start(ok, False, False, 0); box.pack_start(back, False, False, 0)
        self.row(g, "", box)
        return g

    def design_run(self, _b, what):
        arg = self.design_cb.get_active_id() if what == "apply" else "zurueck"
        r = subprocess.run(["/usr/local/bin/design-apply", arg], capture_output=True, text=True)
        self.msg(r.stdout.strip() + "\nOffene Programme bitte einmal neu starten." if r.returncode == 0
                 else "Nicht geändert: " + (r.stderr.strip() or "Fehler"))

    # ---------- Logik ----------
    def rgba(self, h):
        r = Gdk.RGBA(); r.parse(h); return r

    def set(self, key, val):
        if self.building:
            return
        self.c[key] = val
        if key == "fontSize":
            for scale in self.font_scales:
                if int(scale.get_value()) != val:
                    scale.set_value(val)
        if key in ("fontFamily", "LogoPreviewSize"):
            self.apply_banner_preview_font()
        if key == "TerminalTransparency" and val == 100 and self.c["TerminalBackgroundImage"]:
            self.c["TerminalBackgroundImage"] = ""
            self.w["bgimg"].set_active_id("")
        self.preview.queue_draw()

    def preview_preset(self, _widget, _event, name):
        self.preview_override = dict(self.c)
        self.preview_override.update(self.profile_c(name))
        self.preview.queue_draw()
        return False

    def clear_preview_override(self, _widget, _event):
        self.preview_override = None
        self.preview.queue_draw()
        return False

    def set_banner(self, key, val):
        self.b[key] = val
        self.update_banner_preview()

    def banner_color_changed(self, btn, key):
        r = btn.get_rgba()
        self.b[key] = "#%02x%02x%02x" % (int(r.red * 255), int(r.green * 255), int(r.blue * 255))
        self.rainbow_switch.set_active(False)
        self.update_banner_preview()

    def key_pressed(self, _widget, event):
        hotkey = self.event_hotkey(event)
        if self.recording_hotkey:
            if hotkey:
                self.record_step(hotkey)
            return True
        if self.test_entry is not None and self.get_focus() is self.test_entry:
            return False              # im Tastentest schaltet keine Taste etwas aus
        actions = self.c["studioShortcuts"]
        if hotkey == "Alt+A":
            focus = self.get_focus()
            if not isinstance(focus, (Gtk.Entry, Gtk.TextView)):
                focus = self.last_text_focus
            if isinstance(focus, Gtk.Entry):
                focus.select_region(0, -1)
                return True
            if isinstance(focus, Gtk.TextView):
                buf = focus.get_buffer()
                buf.select_range(buf.get_start_iter(), buf.get_end_iter())
                return True
        if hotkey:
            state, action = self.sequences.feed(hotkey, actions)
            if state == "wartet":
                self.show_sequence_hint(action)
                return True
            self.clear_sequence_hint()
            if state == "treffer":
                self.run_studio_action(action)
                return True
        if hotkey and hotkey == actions.get("close"):
            self.confirm_close()
            return True
        if hotkey in (actions.get("copy"), actions.get("paste")) and hotkey:
            focus = self.get_focus()
            if isinstance(focus, Gtk.TextView):
                clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                if hotkey == actions.get("copy"):
                    focus.get_buffer().copy_clipboard(clipboard)
                elif focus.get_editable():
                    focus.get_buffer().paste_clipboard(clipboard, None, True)
                return True
            if isinstance(focus, Gtk.Entry):
                if hotkey == actions.get("copy"):
                    focus.copy_clipboard()
                else:
                    focus.paste_clipboard()
                return True
        if hotkey == actions.get("save") and hotkey:
            self.save(None, False); return True
        if hotkey == actions.get("test") and hotkey:
            self.save(None, True); return True
        if hotkey == actions.get("preview") and hotkey:
            self.open_large_banner_preview(None); return True
        return False

    def remember_text_focus(self, _window, widget):
        if isinstance(widget, (Gtk.Entry, Gtk.TextView)):
            self.last_text_focus = widget

    def confirm_delete(self, _widget, _event):
        return False                    # keine Speichern-Nachfrage: Fenster schliesst einfach (Nutzerwunsch)

    def flash_close_border(self, window):
        context = window.get_style_context()
        state = {"on": False}
        def tick():
            if not window.get_visible():
                context.remove_class("close-pending")
                return False
            state["on"] = not state["on"]
            (context.add_class if state["on"] else context.remove_class)("close-pending")
            return True
        tick()
        return GLib.timeout_add(300, tick)

    def stop_close_border(self, window, source):
        if source:
            GLib.source_remove(source)
        window.get_style_context().remove_class("close-pending")

    def run_closable_dialog(self, dialog, keep_alive=False):
        state = {"pending": False, "flash": None}
        def on_key(_widget, event):
            if Gdk.keyval_name(event.keyval) not in ("Escape", "dead_circumflex", "asciicircum"):
                return False
            if state["pending"]:
                dialog.response(Gtk.ResponseType.CANCEL)
            else:
                state["pending"] = True
                state["flash"] = self.flash_close_border(dialog)
                dialog.set_title("Nochmal ^: schließen")
            return True
        dialog.connect("key-press-event", on_key)
        response = dialog.run()
        self.stop_close_border(dialog, state["flash"])
        if not keep_alive:
            dialog.destroy()
        return response

    def confirm_close(self):
        self.destroy()                  # ^,1 schliesst sofort, ohne Nachfrage (Nutzerwunsch)
        return
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.NONE, text="Terminal-Studio wirklich schließen?")
        d.format_secondary_text("^ speichert und schließt das Studio. „Zurück“ bricht ab.")
        d.add_button("Zurück", Gtk.ResponseType.CANCEL)
        d.add_button("Ohne Speichern schließen", Gtk.ResponseType.NO)
        d.add_button("Speichern & Schließen", Gtk.ResponseType.YES)
        def second_escape(dialog, event):
            if Gdk.keyval_name(event.keyval) in ("Escape", "dead_circumflex", "asciicircum"):
                dialog.response(Gtk.ResponseType.YES)
                return True
            return False
        d.connect("key-press-event", second_escape)
        flash = self.flash_close_border(self)
        response = d.run()
        self.stop_close_border(self, flash)
        d.destroy()
        if response == Gtk.ResponseType.YES:
            if not self.save(None, False, quiet=True):
                return
            self.destroy()
        elif response == Gtk.ResponseType.NO:
            self.destroy()

    def logo_choices_list(self):
        choices = [(key, label) for key, (label, _path) in LOGO_ARTS.items()
                   if key in ("aus", "custom") or key not in self.hidden_logos]
        choices.extend(("user:" + item["id"], item["name"]) for item in self.own_logos)
        return choices

    def hide_builtin_logo(self, _button):
        key = self.b.get("LOGO_ART", "")
        if key not in LOGO_ARTS or key in ("aus", "custom"):
            self.logo_status.set_text("Wähle zuerst ein vorinstalliertes Logo aus.")
            return
        self.hidden_logos.add(key)
        self.b["HIDDEN_LOGOS"] = ",".join(sorted(self.hidden_logos))
        self.b["LOGO_ART"] = "aus"
        self.refresh_logo_choices()
        self.update_banner_preview()
        self.logo_status.set_text("Logo aus der Auswahl entfernt. Du kannst es wiederherstellen.")

    def restore_builtin_logos(self, _button):
        self.hidden_logos.clear()
        self.b["HIDDEN_LOGOS"] = ""
        self.refresh_logo_choices()
        self.logo_status.set_text("Vorinstallierte Logos sind wieder auswählbar.")

    def refresh_logo_choices(self):
        for child in self.logo_choices.get_children():
            child.destroy()
        self.fill_hover_choice(self.logo_choices, "LOGO_ART", self.logo_choices_list())
        self.logo_choices.show_all()

    def paste_logo(self, _button):
        text = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text()
        if text:
            self.custom_logo_buffer.set_text(text)
            self.logo_status.set_text("Eingefügt. Gib dem Bild einen Namen und klicke auf „Als Option speichern“.")
        else:
            self.logo_status.set_text("In der Zwischenablage ist kein Textbild.")

    def add_own_logo(self, _button):
        source = self.preview_logo_name if _button is self.preview_logo_save else self.logo_name_entry
        name = source.get_text().strip()
        art = self.current_custom_logo_text().rstrip("\n")
        if not name or not art or art.startswith("Fuege im Terminal-Studio"):
            self.logo_status.set_text("Bitte zuerst einen Namen eingeben und ein Textbild einfügen.")
            return
        item = {"id": uuid.uuid4().hex, "name": name[:60], "art": art}
        self.own_logos.append(item)
        self.b["LOGO_ART"] = "user:" + item["id"]
        self.logo_name_entry.set_text("")
        self.preview_logo_name.set_text("")
        self.refresh_logo_choices()
        self.update_banner_preview()
        if self.save(None, False, quiet=True):
            self.logo_status.set_text("„%s“ ist gespeichert und als Option auswählbar." % item["name"])
        else:
            self.logo_status.set_text("Speichern fehlgeschlagen. Versuch es unten erneut mit „Speichern“.")

    def remove_own_logo(self, _button):
        key = self.b.get("LOGO_ART", "")
        if not key.startswith("user:"):
            self.logo_status.set_text("Wähle zuerst eines deiner eigenen Logos aus.")
            return
        removed = next((item for item in self.own_logos if "user:" + item["id"] == key), None)
        self.own_logos = [item for item in self.own_logos if "user:" + item["id"] != key]
        if removed and self.current_custom_logo_text().rstrip("\n") == removed["art"].rstrip("\n"):
            self.custom_logo_buffer.set_text("")
        self.b["LOGO_ART"] = "aus"
        self.banner_preview_override = None
        self.refresh_logo_choices()
        self.update_banner_preview()
        if self.save(None, False, quiet=True):
            self.logo_status.set_text("Eigenes Logo gelöscht.")
        else:
            self.logo_status.set_text("Löschen noch nicht gespeichert. Versuch es unten erneut mit „Speichern“.")

    # ---------- Profile ----------
    def profile_names(self):
        versteckt = set(self.profiles["hidden"])
        return [n for n in PRESETS if n not in versteckt] + list(self.profiles["own"])

    def profile_c(self, name):
        if name in self.profiles["own"]:
            return self.profiles["own"][name].get("c", {})
        return PRESETS.get(name, {})

    def profile_b(self, name):
        if name in self.profiles["own"]:
            return self.profiles["own"][name].get("b", {})
        return {}

    def build_profile_buttons(self):
        for child in self.profile_flow.get_children():
            child.destroy()
        self.preset_buttons = []
        for name in self.profile_names():
            b = Gtk.Button(label=name)
            if name in self.profiles["own"]:
                b.set_tooltip_text("Mein Profil")
            b.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            b.connect("enter-notify-event", self.preview_preset, name)
            b.connect("leave-notify-event", self.clear_preview_override)
            b.connect("clicked", self.apply_preset, name)
            self.profile_flow.add(b)
            self.preset_buttons.append(b)
        self.profile_flow.show_all()

    def profile_snapshot(self):
        return {"c": {k: json.loads(json.dumps(self.c[k])) for k in PROFILE_C_KEYS if k in self.c},
                "b": {k: str(self.b[k]) for k in PROFILE_B_KEYS if k in self.b}}

    def profile_speichern(self, name):
        """Speichert den aktuellen Stand unter einem Namen. Gibt eine Fehlermeldung oder None zurück."""
        name = clean_profile_name(name)
        if not name:
            return "Bitte einen Namen eingeben."
        if name in PRESETS:
            return "Diesen Namen gibt es schon als Vorlage. Nimm einen anderen Namen."
        self.profiles["own"][name] = self.profile_snapshot()
        save_profiles(self.profiles)
        self.build_profile_buttons()
        return None

    def profile_loeschen(self, names):
        """Eigene Profile werden gelöscht, Vorlagen nur ausgeblendet."""
        for name in names:
            if name in self.profiles["own"]:
                del self.profiles["own"][name]
            elif name in PRESETS and name not in self.profiles["hidden"]:
                self.profiles["hidden"].append(name)
        save_profiles(self.profiles)
        self.build_profile_buttons()

    def profile_speichern_dialog(self, _b):
        d = Gtk.Dialog(title="Als Profil speichern", transient_for=self, modal=True)
        d.add_button("Abbrechen", Gtk.ResponseType.CANCEL)
        d.add_button("Speichern", Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(8); box.set_border_width(12)
        text = Gtk.Label(label="Name für dein Profil.\nGespeichert werden Schrift, Farben, Hintergrund, Cursor und Logo.", xalign=0)
        entry = Gtk.Entry(); entry.set_activates_default(True); entry.set_placeholder_text("z. B. Mein Rot")
        box.pack_start(text, False, False, 0); box.pack_start(entry, False, False, 0)
        d.set_default_response(Gtk.ResponseType.OK)
        d.show_all()
        antwort = self.run_closable_dialog(d, keep_alive=True)
        name = clean_profile_name(entry.get_text())
        d.destroy()
        if antwort != Gtk.ResponseType.OK:
            return
        if name in self.profiles["own"]:
            q = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.NONE, text=f"Profil „{name}“ überschreiben?")
            q.add_button("Abbrechen", Gtk.ResponseType.CANCEL)
            q.add_button("Überschreiben", Gtk.ResponseType.OK)
            if self.run_closable_dialog(q) != Gtk.ResponseType.OK:
                return
        fehler = self.profile_speichern(name)
        self.msg(fehler or f"Profil „{name}“ ist gespeichert und steht oben in der Zeile „Profile“.\n"
                           "Damit deine Terminals so aussehen, klicke danach auf „Speichern“.")

    def profile_loeschen_dialog(self, _b):
        d = Gtk.Dialog(title="Profile löschen", transient_for=self, modal=True)
        d.set_default_size(440, 380)
        box = d.get_content_area()
        box.set_spacing(8); box.set_border_width(12)
        hinweis = Gtk.Label(label="Wähle die Profile, die weg sollen (mehrere möglich).\n"
                                  "Vorlagen werden nur ausgeblendet und lassen sich zurückholen.", xalign=0)
        box.pack_start(hinweis, False, False, 0)
        speicher = Gtk.ListStore(str, str)
        ansicht = Gtk.TreeView(model=speicher)
        for i, titel in enumerate(("Profil", "Art")):
            ansicht.append_column(Gtk.TreeViewColumn(titel, Gtk.CellRendererText(), text=i))
        ansicht.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        rolle = Gtk.ScrolledWindow(); rolle.set_vexpand(True); rolle.add(ansicht)
        box.pack_start(rolle, True, True, 0)

        def fuellen():
            speicher.clear()
            for n in self.profile_names():
                speicher.append([n, "mein Profil" if n in self.profiles["own"] else "Vorlage"])
        fuellen()
        d.add_button("Schließen", Gtk.ResponseType.CANCEL)
        d.add_button("Ausgewählte löschen", Gtk.ResponseType.OK)
        d.show_all()
        while True:
            antwort = self.run_closable_dialog(d, keep_alive=True)
            if antwort != Gtk.ResponseType.OK:
                break
            modell, pfade = ansicht.get_selection().get_selected_rows()
            namen = [modell[p][0] for p in pfade]
            if not namen:
                hinweis.set_text("Bitte zuerst ein Profil anklicken.")
                continue
            self.profile_loeschen(namen)
            fuellen()
            hinweis.set_text(f"{len(namen)} Profil(e) entfernt.")
        d.destroy()

    def profile_zurueckholen(self, _b):
        if not self.profiles["hidden"]:
            self.msg("Es sind keine Vorlagen ausgeblendet.")
            return
        self.profiles["hidden"] = []
        save_profiles(self.profiles)
        self.build_profile_buttons()
        self.msg("Die eingebauten Vorlagen sind wieder da.")

    # ---------- Eigene Logos verwalten ----------
    def eigene_logos_loeschen(self, ids):
        """Entfernt eigene Logos aus dem Studio (gespeichert wird danach mit save). Gibt die Anzahl zurück."""
        ids = set(ids)
        entfernt = [i for i in self.own_logos if i["id"] in ids]
        if not entfernt:
            return 0
        self.own_logos = [i for i in self.own_logos if i["id"] not in ids]
        aktuell = self.current_custom_logo_text().rstrip("\n")
        if any(i["art"].rstrip("\n") == aktuell for i in entfernt):
            self.custom_logo_buffer.set_text("")
        art = self.b.get("LOGO_ART", "")
        if art.startswith("user:") and art[5:] in ids:
            self.b["LOGO_ART"] = "aus"
        self.banner_preview_override = None
        self.refresh_logo_choices()
        self.update_banner_preview()
        return len(entfernt)

    def logos_verwalten_dialog(self, _b):
        d = Gtk.Dialog(title="Eigene Logos verwalten", transient_for=self, modal=True)
        d.set_default_size(460, 420)
        box = d.get_content_area()
        box.set_spacing(8); box.set_border_width(12)
        hinweis = Gtk.Label(label="Wähle Logos zum Löschen (mehrere möglich). Gespeichert wird beim Schließen.", xalign=0)
        box.pack_start(hinweis, False, False, 0)
        speicher = Gtk.ListStore(str, str)
        ansicht = Gtk.TreeView(model=speicher)
        ansicht.append_column(Gtk.TreeViewColumn("Logo", Gtk.CellRendererText(), text=1))
        ansicht.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        rolle = Gtk.ScrolledWindow(); rolle.set_vexpand(True); rolle.add(ansicht)
        box.pack_start(rolle, True, True, 0)

        def fuellen():
            speicher.clear()
            for i in self.own_logos:
                speicher.append([i["id"], i["name"]])
            hinweis.set_text(f"{len(self.own_logos)} eigene Logos." if self.own_logos else "Keine eigenen Logos gespeichert.")
        fuellen()
        d.add_button("Schließen", Gtk.ResponseType.CANCEL)
        d.add_button("Alle löschen", 2)
        d.add_button("Ausgewählte löschen", Gtk.ResponseType.OK)
        d.show_all()
        geloescht = 0
        while True:
            antwort = self.run_closable_dialog(d, keep_alive=True)
            if antwort == 2:
                q = Gtk.MessageDialog(transient_for=d, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      buttons=Gtk.ButtonsType.NONE, text="Wirklich ALLE eigenen Logos löschen?")
                q.add_button("Abbrechen", Gtk.ResponseType.CANCEL)
                q.add_button("Alle löschen", Gtk.ResponseType.OK)
                if self.run_closable_dialog(q) == Gtk.ResponseType.OK:
                    geloescht += self.eigene_logos_loeschen([i["id"] for i in self.own_logos])
                    fuellen()
                continue
            if antwort != Gtk.ResponseType.OK:
                break
            modell, pfade = ansicht.get_selection().get_selected_rows()
            ids = [modell[p][0] for p in pfade]
            if not ids:
                hinweis.set_text("Bitte zuerst ein Logo anklicken.")
                continue
            geloescht += self.eigene_logos_loeschen(ids)
            fuellen()
        d.destroy()
        if geloescht:
            if self.save(None, False, quiet=True):
                self.logo_status.set_text(f"{geloescht} Logo(s) gelöscht und gespeichert.")
            else:
                self.logo_status.set_text("Gelöscht, aber noch nicht gespeichert. Versuch es mit „Speichern“ erneut.")

    def hover_choice(self, config_key, choices):
        box = Gtk.FlowBox()
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.set_max_children_per_line(3)
        box.set_row_spacing(4); box.set_column_spacing(4)
        self.fill_hover_choice(box, config_key, choices)
        return box

    def fill_hover_choice(self, box, config_key, choices):
        current = self.b.get(config_key, "")
        for value, label in choices:
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("flat")
            if value == current:
                button.get_style_context().add_class("suggested-action")
            button.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            button.connect("enter-notify-event", self.preview_banner_choice, config_key, value)
            button.connect("leave-notify-event", self.clear_banner_choice_preview)
            button.connect("clicked", self.choose_banner_value, config_key, value)
            box.add(button)

    def preview_banner_choice(self, _widget, _event, config_key, value):
        self.banner_preview_override = {config_key: value}
        self.update_banner_preview()
        return False

    def clear_banner_choice_preview(self, _widget, _event):
        self.banner_preview_override = None
        self.update_banner_preview()
        return False

    def choose_banner_value(self, _widget, config_key, value):
        self.b[config_key] = value
        self.banner_preview_override = None
        if config_key == "LOGO_ART":
            self.refresh_logo_choices()
        self.update_banner_preview()

    def update_banner_preview(self):
        if getattr(self, "banner_preview_buffer", None) is not None:
            custom_text = self.current_custom_logo_text() if getattr(self, "custom_logo_buffer", None) is not None else None
            banner = dict(self.b)
            if self.banner_preview_override:
                banner.update(self.banner_preview_override)
            editing = self.b.get("LOGO_ART") == "custom" and not self.banner_preview_override
            self.banner_view.set_editable(editing)
            self.banner_view.set_cursor_visible(editing)
            if getattr(self, "preview_logo_tools", None) is not None:
                self.preview_logo_tools.set_visible(editing and self.notebook.get_current_page() == 4)
            text = custom_text if editing else render_banner_text(banner, custom_text, self.own_logos)
            width = max((len(line) for line in (text or "").splitlines()), default=0)
            self.preview_width_hint.set_text(
                "Bildbreite: %d Spalten. Ein neues QTerminal-Fenster wird bei Bedarf verbreitert." % width)
            self._updating_banner_preview = True
            try:
                self.banner_preview_buffer.set_text(text or "")
            finally:
                self._updating_banner_preview = False
            self.apply_banner_preview_colors(banner, editing)
            self.apply_banner_preview_font()
        self.preview.queue_draw()

    def banner_preview_changed(self, buffer):
        if getattr(self, "_updating_banner_preview", False) or getattr(self, "custom_logo_buffer", None) is None:
            return
        text = buffer.get_text(*buffer.get_bounds(), True)
        width = max((len(line) for line in text.splitlines()), default=0)
        self.preview_width_hint.set_text(
            "Bildbreite: %d Spalten. Ein neues QTerminal-Fenster wird bei Bedarf verbreitert." % width)
        self.apply_banner_preview_colors(self.b, True)
        self._editing_banner_preview = True
        try:
            self.custom_logo_buffer.set_text(text)
        finally:
            self._editing_banner_preview = False

    def apply_banner_preview_colors(self, banner, editing):
        buffer = self.banner_preview_buffer
        start, end = buffer.get_bounds()
        buffer.remove_all_tags(start, end)
        if editing:
            logo_lines = buffer.get_line_count()
        else:
            key = banner.get("LOGO_ART", "aus")
            if key == "custom":
                logo = self.current_custom_logo_text()
            elif key.startswith("user:"):
                logo = next((item["art"] for item in self.own_logos if "user:" + item["id"] == key), "")
            else:
                logo = logo_art(key)
            logo_lines = len(logo.splitlines()) if key != "aus" else 0
        rainbow = banner.get("REGENBOGEN") == "ja"
        palette = ("#ff5555", "#ffaa55", "#f5dd55", "#77dd88", "#66bbff", "#bb88ff")
        for line in range(buffer.get_line_count()):
            color = palette[line % len(palette)] if rainbow else banner["LOGO_COLOR" if line < logo_lines else "BANNER_COLOR"]
            vf = [x for x in banner.get("LOGO_FARBEN", "").split(",") if x]
            if not rainbow and vf and line < logo_lines:
                try:
                    import logo_farben
                    color = logo_farben.verlauf_farbe(vf, line, logo_lines)
                except Exception:
                    pass
            tag = self._preview_color_tags.get(color)
            if tag is None:
                tag = buffer.create_tag(None, foreground=color)
                self._preview_color_tags[color] = tag
            a = buffer.get_iter_at_line(line)
            b = buffer.get_iter_at_line(line + 1) if line + 1 < buffer.get_line_count() else buffer.get_end_iter()
            buffer.apply_tag(tag, a, b)

    def banner_preview_resized(self, _widget, _allocation):
        if self.fit_banner:
            self.apply_banner_preview_font()

    def toggle_fit_banner(self, _button):
        self.fit_banner = not self.fit_banner
        self.fit_button.set_label("Originalgröße" if self.fit_banner else "Ganz einpassen")
        self.apply_banner_preview_font()

    def apply_banner_preview_font(self):
        size = int(self.c["LogoPreviewSize"])
        if self.fit_banner:
            text = self.banner_preview_buffer.get_text(*self.banner_preview_buffer.get_bounds(), True)
            layout = self.banner_view.create_pango_layout(text)
            layout.set_font_description(Pango.FontDescription(f"{self.c['fontFamily']} {size}"))
            width, height = layout.get_pixel_size()
            available_w = max(1, self.banner_scroll.get_allocated_width() - 28)
            available_h = max(1, self.banner_scroll.get_allocated_height() - 28)
            scale = min(1.0, available_w / max(1, width), available_h / max(1, height))
            size = max(2, int(size * scale))
        font = Pango.FontDescription(f"{self.c['fontFamily']} {size}")
        if self.banner_view.get_style_context() and font.to_string() != getattr(self, "_banner_font", None):
            self.banner_view.override_font(font)
            self._banner_font = font.to_string()

    def custom_logo_changed(self):
        if self._editing_banner_preview:
            return
        if self.b.get("LOGO_ART") != "custom":
            self.b["LOGO_ART"] = "custom"
            self.refresh_logo_choices()
        self.update_banner_preview()

    def switch_preview_page(self, _notebook, _page, index):
        boot = index == getattr(self, "boot_tab_index", -1)
        extra = getattr(self, "extra_previews", {}).get(index)
        self.preview_stack.set_visible_child_name(
            "banner" if index == 4 else "codex" if index == 8 else "boot" if boot else extra or "terminal")
        self.preview_heading.set_text("KI-Terminal-Vorschau rechts" if index == 8 else
                                      "Ladebildschirm-Vorschau (ungefähr)" if boot else
                                      "Desktop-Bild-Vorschau" if extra == "wall" else
                                      "Vorschau rechts – großes Bild: scrollen")
        self.fit_button.set_visible(index == 4)
        self.full_button.set_visible(index == 4)
        if index == 4 and self.b.get("LOGO_ART") == "custom":
            self.preview_logo_tools.show_all()
        else:
            self.preview_logo_tools.hide()
        self.preview_width_hint.set_visible(index == 4)
        self.update_codex_preview()
        self.preview.queue_draw()

    def open_large_banner_preview(self, _button):
        if self.notebook.get_current_page() != 4:
            self.notebook.set_current_page(4)
        dialog = Gtk.Dialog(title="Banner-Vorschau", transient_for=self, flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("Schließen", Gtk.ResponseType.CLOSE)
        view = Gtk.TextView.new_with_buffer(self.banner_preview_buffer)
        if self.b.get("LOGO_ART") == "custom":
            view = Gtk.TextView()
            view.get_buffer().set_text(render_banner_text(self.b, self.current_custom_logo_text(), self.own_logos))
        view.set_editable(False); view.set_cursor_visible(False)
        view.set_monospace(True); view.set_wrap_mode(Gtk.WrapMode.NONE)
        view.override_font(Pango.FontDescription(
            f"{self.c['fontFamily']} {self.c['LogoPreviewSize']}"))
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(view)
        dialog.get_content_area().add(scroll)
        dialog.set_default_size(1100, 700)
        dialog.show_all(); self.run_closable_dialog(dialog)

    def make_fully_transparent(self, _button):
        self.w["TerminalTransparency"].set_value(100)
        self.w["bgimg"].set_active_id("")

    def current_custom_logo_text(self):
        if getattr(self, "custom_logo_buffer", None) is None:
            return load_custom_logo()
        start, end = self.custom_logo_buffer.get_bounds()
        return self.custom_logo_buffer.get_text(start, end, True)

    def custom_color(self, btn, k):
        r = btn.get_rgba()
        self.c["custom"][k] = "#%02x%02x%02x" % (int(r.red * 255), int(r.green * 255), int(r.blue * 255))
        if self.c["colorScheme"] != "Eigenes":
            self.w["colorScheme"].set_active_id("Eigenes")
        self.preview.queue_draw()

    def ansi_color_changed(self, btn, index):
        r = btn.get_rgba()
        self.c["custom"]["ansi"][index] = "#%02x%02x%02x" % (
            int(r.red * 255), int(r.green * 255), int(r.blue * 255))
        self.w["colorScheme"].set_active_id("Eigenes")
        self.preview.queue_draw()

    def input_color_changed(self, btn):
        r = btn.get_rgba()
        self.b["INPUT_COLOR"] = "#%02x%02x%02x" % (int(r.red * 255), int(r.green * 255), int(r.blue * 255))
        self.preview.queue_draw()

    def color_palette(self, target):
        box = Gtk.FlowBox()
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.set_max_children_per_line(4)
        for name, color in TEXT_COLORS:
            button = Gtk.Button(label=name)
            button.connect("clicked", self.pick_text_color, target, color)
            box.add(button)
        return box

    def color_styles(self):
        box = Gtk.FlowBox()
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.set_max_children_per_line(3)
        for name in TEXT_STYLES:
            button = Gtk.Button(label=name)
            button.connect("clicked", self.pick_text_style, name)
            box.add(button)
        return box

    def pick_text_style(self, _button, name):
        bg, fg, input_color, accent = TEXT_STYLES[name]
        self.c["custom"].update(bg=bg, fg=fg, accent=accent)
        self.c["custom"]["ansi"] = default_ansi(self.c["custom"])
        self.b["INPUT_COLOR"] = input_color
        for key, color in (("bg", bg), ("fg", fg), ("accent", accent)):
            self.custom_buttons[key].set_rgba(self.rgba(color))
        self.input_color_button.set_rgba(self.rgba(input_color))
        for i, button in enumerate(self.ansi_buttons):
            button.set_rgba(self.rgba(self.c["custom"]["ansi"][i]))
        self.w["colorScheme"].set_active_id("Eigenes")
        self.preview.queue_draw()

    def pick_text_color(self, _button, target, color):
        if target == "input":
            self.b["INPUT_COLOR"] = color
            self.input_color_button.set_rgba(self.rgba(color))
        else:
            self.c["custom"]["fg"] = color
            self.output_color_button.set_rgba(self.rgba(color))
            self.w["colorScheme"].set_active_id("Eigenes")
        self.preview.queue_draw()

    def bg_changed(self, cb):
        v = cb.get_active_id()
        if v == "__folder__":
            d = Gtk.FileChooserDialog(title="Bilderordner wählen", parent=self,
                                      action=Gtk.FileChooserAction.SELECT_FOLDER)
            d.add_buttons("Abbrechen", Gtk.ResponseType.CANCEL, "Ordner wählen", Gtk.ResponseType.OK)
            if self.c.get("BackgroundImageFolder"):
                d.set_current_folder(self.c["BackgroundImageFolder"])
            response = self.run_closable_dialog(d, keep_alive=True)
            folder = d.get_filename() if response == Gtk.ResponseType.OK else None
            d.destroy()
            if folder:
                self.c["BackgroundImageFolder"] = folder
                images = self.add_folder_images(cb, folder)
                if images:
                    cb.set_active_id(images[0])
                    return
                self.msg("In diesem Ordner wurden keine Bilder gefunden.")
            cb.set_active_id(self.c["TerminalBackgroundImage"])
            return
        if v == "__logo__":
            try:
                sys.path.insert(0, "/usr/local/lib/terminal-studio-mods")
                import logo_hintergrund
                def art_von(key):
                    if key == "custom":
                        return self.current_custom_logo_text()
                    if key.startswith("user:"):
                        return next((i["art"] for i in self.own_logos if "user:" + i["id"] == key), "")
                    return logo_art(key)
                png = logo_hintergrund.dialog(self, self.logo_choices_list(), art_von)
            except Exception as fehler:
                self.msg("Logo-Hintergrund ging nicht: %s" % fehler); png = None
            if png:
                cb.append(png, "Text-Logo (Mitte)")
                self.c["TerminalBackgroundMode"] = 2
                if self.w.get("TerminalBackgroundMode"):
                    self.w["TerminalBackgroundMode"].set_active_id("2")
                cb.set_active_id(png)
            else:
                cb.set_active_id(self.c["TerminalBackgroundImage"])
            return
        if v == "__file__":
            d = Gtk.FileChooserDialog(title="Bild wählen", parent=self, action=Gtk.FileChooserAction.OPEN)
            d.add_buttons("Abbrechen", Gtk.ResponseType.CANCEL, "Öffnen", Gtk.ResponseType.OK)
            f = Gtk.FileFilter(); f.set_name("Bilder"); f.add_mime_type("image/*"); d.add_filter(f)
            response = self.run_closable_dialog(d, keep_alive=True)
            if response == Gtk.ResponseType.OK:
                v = d.get_filename(); cb.append(v, os.path.basename(v))
            else:
                v = self.c["TerminalBackgroundImage"]
            d.destroy()
            cb.set_active_id(v); return
        self.set("TerminalBackgroundImage", v or "")

    def apply_preset(self, _b, name):
        for key, value in self.profile_c(name).items():
            if key not in PROFILE_C_KEYS:
                continue
            alt = self.c.get(key)
            zahl = (int, float)
            if alt is not None and type(value) is not type(alt) and not (
                    isinstance(value, zahl) and isinstance(alt, zahl) and
                    not isinstance(value, bool) and not isinstance(alt, bool)):
                continue                      # falscher Typ in einer Profil-Datei: ignorieren
            self.c[key] = json.loads(json.dumps(value))
        b_update = self.profile_b(name)
        for key in PROFILE_B_KEYS:
            if key in b_update:
                self.b[key] = str(b_update[key])
        art = self.b.get("LOGO_ART", "")
        if art.startswith("user:") and not any("user:" + i["id"] == art for i in self.own_logos):
            self.b["LOGO_ART"] = "aus"        # dieses eigene Logo wurde inzwischen gelöscht
        self.preview_override = None
        self.refresh_widgets()
        if b_update:
            self.rebuild_banner_page()

    def rebuild_banner_page(self):
        seite = self.notebook.get_current_page()
        self.notebook.remove_page(4)
        self.notebook.insert_page(self.page_banner(), Gtk.Label(label="Banner & tmux"), 4)
        self.notebook.show_all()
        self.notebook.set_current_page(seite)

    def reset_all(self, _b):
        d = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.YES_NO,
                              text="Wirklich alles auf Standard zurück?")
        d.format_secondary_text("Schrift, Farben, Hintergrund, Cursor, Banner, Leiste, Codex, Desktop-Bild und Sperre & Energie "
                                "gehen auf die Ausgangswerte. Die Leiste und das Terminal übernehmen es mit „Speichern“, "
                                "Sperre & Energie gilt sofort.")
        antwort = d.run(); d.destroy()
        if antwort != Gtk.ResponseType.YES:
            return
        self.reset(_b)
        if hasattr(self, "sperre_standard"):
            self.sperre_standard()
        if hasattr(self, "wall_standard"):
            self.wall_standard()

    def reset(self, _b):
        self.c = json.loads(json.dumps(DEFAULTS))
        self.codex_ui = json.loads(json.dumps(CODEX_DEFAULTS))
        self.c["custom"]["ansi"] = default_ansi(self.c["custom"])
        self.c["custom"]["fg_bright"] = "#ffffff"
        self.refresh_widgets()

    def refresh_widgets(self):
        self.building = True
        for k, wd in self.w.items():
            if k == "bgimg":
                v = self.c["TerminalBackgroundImage"]
                if not wd.set_active_id(v):
                    wd.append(v, os.path.basename(v)); wd.set_active_id(v)
            elif isinstance(wd, Gtk.Scale):
                wd.set_value(self.c[k])
            elif isinstance(wd, Gtk.Switch):
                wd.set_active(self.c[k])
            elif isinstance(wd, Gtk.ComboBoxText):
                wd.set_active_id(str(self.c[k]))
        self.building = False
        for key, button in self.custom_buttons.items():
            button.set_rgba(self.rgba(self.c["custom"][key]))
        for index, button in enumerate(self.ansi_buttons):
            button.set_rgba(self.rgba(self.c["custom"]["ansi"][index]))
        for scale in self.font_scales:
            scale.set_value(self.c["fontSize"])
        self.apply_banner_preview_font()
        for key, combo in self.codex_color_combos.items():
            combo.set_active_id(self.codex_ui[key])
            self.codex_color_buttons[key].set_rgba(self.rgba(self.codex_ui["custom_colors"][key]))
        for key, button in self.codex_terminal_buttons.items():
            value = (self.b["INPUT_COLOR"] if key == "input" else
                     self.c["custom"]["ansi"][{"link": 4, "error": 1, "success": 2}[key]]
                     if key in ("link", "error", "success") else self.c["custom"][key])
            button.set_rgba(self.rgba(value))
        for key, widget in self.codex_switches.items():
            widget.set_active(self.codex_ui[key])
            self.codex_position_combos[key].set_active_id(self.codex_ui["locations"][key])
        for key, button in getattr(self, "chat_input_buttons", {}).items():
            button.set_rgba(self.rgba(self.codex_ui.get(key) or self.c["custom"]["fg"]))
        self.codex_summary_switch.set_active(self.codex_ui["chat_summary"])
        self.codex_summary_spin.set_value(self.codex_ui["summary_lines"])
        self.codex_animation_combo.set_active_id(self.codex_ui["animation"])
        self.codex_limit_combo.set_active_id(self.codex_ui["limit_display"])
        self.update_codex_preview()
        self.preview.queue_draw()

    def colors(self):
        if self.c["colorScheme"] == "Eigenes":
            cu = self.c["custom"]; ansi = cu["ansi"]
            return (hex2rgb(cu["bg"]), hex2rgb(cu["fg"]), hex2rgb(ansi[1]),
                    hex2rgb(ansi[2]), hex2rgb(ansi[4]))
        return read_scheme(self.c["colorScheme"])

    def draw_preview(self, area, cr):
        W, H = area.get_allocated_width(), area.get_allocated_height()
        if self.preview_override is not None and self.notebook.get_current_page() != 4:
            preview_c = self.preview_override
            if preview_c.get("colorScheme") == "Eigenes":
                cu = preview_c["custom"]; bg = hex2rgb(cu["bg"]); fg = hex2rgb(cu["fg"])
                red, green, blue = (hex2rgb(cu["ansi"][i]) for i in (1, 2, 4))
            else:
                bg, fg, red, green, blue = read_scheme(preview_c["colorScheme"])
        else:
            preview_c = self.c
            bg, fg, red, green, blue = self.colors()
        cr.set_source_rgb(.25, .25, .25); cr.paint()  # "Desktop" hinter dem Fenster
        a = 1 - preview_c["TerminalTransparency"] / 100
        img = preview_c["TerminalBackgroundImage"]
        cr.save(); cr.rectangle(10, 10, W - 20, H - 20); cr.clip()
        if img and os.path.exists(img):
            try:
                from gi.repository import GdkPixbuf
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(img, W - 20, H - 20, False)
                Gdk.cairo_set_source_pixbuf(cr, pb, 10, 10); cr.paint()
                a = min(a, .35)
            except Exception:
                pass
        cr.set_source_rgba(*bg, a); cr.paint(); cr.restore()
        if img and os.path.exists(img) and preview_c.get("BackgroundImageDim", 0):
            cr.save(); cr.rectangle(10, 10, W - 20, H - 20); cr.clip()
            cr.set_source_rgba(0, 0, 0, preview_c["BackgroundImageDim"] / 100)
            cr.paint(); cr.restore()
        cr.set_source_rgb(*red); cr.set_line_width(1); cr.rectangle(10.5, 10.5, W - 21, H - 21); cr.stroke()

        m = 10 + preview_c["TerminalMargin"]
        lay = PangoCairo.create_layout(cr)
        lay.set_font_description(Pango.FontDescription(f"{preview_c['fontFamily']} {preview_c['fontSize']}"))
        lines = [
            [(red, "┌──("), (blue, "DEIN_BENUTZER㉿kali"), (red, ")-["), (fg, "~/projekt"), (red, "]")],
            [(red, "└─$ "), (hex2rgb(self.b["INPUT_COLOR"]), "claude")],
            [(green, "✔ "), (fg, "Build fertig in 12s")],
            [(red, "✘ "), (fg, "Fehler: Datei fehlt")],
            [(fg, "ls  "), (blue, "src/  "), (green, "run.sh  "), (fg, "README.md")],
            [(blue, "https://example.org"), (fg, "  Link")],
            [(red, "└─$ ")],
        ]
        y = m + 4
        for parts in lines:
            x = m + 4
            for col, txt in parts:
                lay.set_text(txt, -1); cr.move_to(x, y); cr.set_source_rgb(*col); PangoCairo.show_layout(cr, lay)
                x += lay.get_pixel_size()[0]
            y += lay.get_pixel_size()[1] + 2
        # Cursor
        lay.set_text("█", -1); cw, ch = lay.get_pixel_size(); y -= ch + 2; x -= 0
        cr.set_source_rgb(*fg); shape = preview_c["KeyboardCursorShape"]
        if shape == 0: cr.rectangle(x, y + 2, cw, ch - 2)
        elif shape == 1: cr.rectangle(x, y + ch - 3, cw, 3)
        else: cr.rectangle(x, y + 2, 2, ch - 2)
        cr.fill()
        if preview_c["colorScheme"] == "Eigenes":
            swatches = preview_c["custom"]["ansi"]
            for index, value in enumerate(swatches):
                row, column = divmod(index, 4)
                lay.set_text("%02d %s" % (index, ANSI_NAMES[index % 8][:5]), -1)
                cr.set_source_rgb(*hex2rgb(value))
                cr.move_to(m + 4 + column * max(90, (W - 2 * m - 8) / 4), y + ch + 16 + row * (ch + 5))
                PangoCairo.show_layout(cr, lay)

    def save(self, _b, test, quiet=False):
        c = dict(self.c)
        c["codex_ui"] = self.codex_ui
        c["terminal_style"] = {
            "config": dict(self.b),
            "logos": {name: (self.current_custom_logo_text() if name == "custom" else logo_art(name))
                      for name in LOGO_ARTS if name != "aus"},
            "own_logos": list(self.own_logos),
        }
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
            json.dump(c, f); tmp = f.name
        os.chmod(tmp, 0o644)
        cmd = ["/usr/local/bin/terminal-studio-apply", tmp]
        if os.geteuid() != 0:
            cmd = ["pkexec"] + cmd
        r = subprocess.run(cmd, capture_output=True, text=True)
        os.unlink(tmp)
        if r.returncode != 0:
            self.msg("Nicht gespeichert:\n" + (r.stderr.strip() or "Abgebrochen")); return False
        if test:
            subprocess.Popen(["/usr/local/bin/qterminal-studio"], start_new_session=True)
        elif not quiet:
            self.msg("Gespeichert! Jedes neue Terminal-Fenster sieht jetzt so aus.")
        return True

    def msg(self, text):
        d = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text=text)
        self.run_closable_dialog(d)


if __name__ == "__main__":
    Studio(); Gtk.main()
