LOGO_ARTS = {
    "aus": ("Aus", ""),
    "arch": ("Arch Detail", "logos/arch_detail.txt"),
    "anime": ("Anime Detail", "logos/anime_detail.txt"),
    "anime_arch": ("Anime + Arch Detail", "logos/anime_arch_detail.txt"),
