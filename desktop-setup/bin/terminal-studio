    def codex_hex(self, key):
        choice = self.codex_ui.get(key, "blue")
        return (self.codex_ui["custom_colors"].get(key, "#89b4fa") if choice == "custom"
                else CODEX_PALETTE.get(choice, "#89b4fa"))

    def codex_choice_changed(self, combo, key):
        if self.building or combo.get_active_id() is None:
            return
        self.codex_ui[key] = combo.get_active_id()
        self.update_codex_preview()

    def codex_custom_color_changed(self, button, key):
        if self.building:
            return
        color = button.get_rgba()
        self.codex_ui["custom_colors"][key] = "#%02x%02x%02x" % (
            round(color.red * 255), round(color.green * 255), round(color.blue * 255))
        self.codex_color_combos[key].set_active_id("custom")
        self.update_codex_preview()

    def chat_input_color_changed(self, button, key):
        if self.building:
            return
        color = button.get_rgba()
        self.codex_ui[key] = "#%02x%02x%02x" % (round(color.red * 255), round(color.green * 255), round(color.blue * 255))
        self.update_codex_preview()

    def chat_input_reset(self, _button, key):
        self.codex_ui[key] = ""
        self.building = True
        self.chat_input_buttons[key].set_rgba(self.rgba(self.c["custom"]["fg"]))
        self.building = False
        self.update_codex_preview()

    def codex_setting_changed(self, value, key):
        if self.building:
            return
        self.codex_ui[key] = value
        self.update_codex_preview()

    def codex_location_changed(self, combo, key):
        if self.building or combo.get_active_id() is None:
            return
        self.codex_ui["locations"][key] = combo.get_active_id()
        self.update_codex_preview()

    def codex_terminal_color_changed(self, button, key):
        if self.building:
            return
        color = button.get_rgba()
        value = "#%02x%02x%02x" % (round(color.red * 255), round(color.green * 255), round(color.blue * 255))
        if key == "input":
            self.b["INPUT_COLOR"] = value
            self.input_color_button.set_rgba(self.rgba(value))
        elif key in ("link", "error", "success"):
            index = {"link": 4, "error": 1, "success": 2}[key]
            self.c["custom"]["ansi"][index] = value
            self.ansi_buttons[index].set_rgba(self.rgba(value))
        else:
            self.c["custom"][key] = value
            self.custom_buttons[key].set_rgba(self.rgba(value))
        if key != "input":
            self.c["colorScheme"] = "Eigenes"
            self.w["colorScheme"].set_active_id("Eigenes")
        self.preview.queue_draw()
        self.update_codex_preview()

