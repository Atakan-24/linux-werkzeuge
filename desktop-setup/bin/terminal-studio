    def page_banner(self):
        g = self.grid()
        self.custom_logo_buffer = None
        def sw(key):
            w = Gtk.Switch(active=self.b[key] == "ja", halign=Gtk.Align.START)
            w.connect("notify::active", lambda x, _: self.set_banner(key, "ja" if x.get_active() else "nein")); return w
        e = Gtk.Entry(text=self.b["BANNER_TEXT"])
        e.connect("changed", lambda x: self.set_banner("BANNER_TEXT", x.get_text()))
        logo = self.hover_choice("LOGO_ART", self.logo_choices_list())
        self.logo_choices = logo
        logo_size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 25, 150, 5)
        logo_size.set_digits(0); logo_size.set_value_pos(Gtk.PositionType.RIGHT)
        logo_size._standard = int(BANNER_DEFAULTS.get("LOGO_SCALE", "100"))
        logo_size.set_value(int(self.b.get("LOGO_SCALE", "100")))
        logo_size.connect("value-changed", lambda w: self.set_banner("LOGO_SCALE", str(int(w.get_value()))))
        cb = self.hover_choice("BANNER_SCHRIFT", figlet_fonts())
        spacing = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 8, 1)
        spacing.set_digits(0); spacing.set_value_pos(Gtk.PositionType.RIGHT)
        spacing._standard = int(BANNER_DEFAULTS.get("BANNER_SPACING", "1"))
        try:
            spacing.set_value(int(self.b["BANNER_SPACING"]))
        except ValueError:
            spacing.set_value(1)
        spacing.connect("value-changed", lambda x: self.set_banner("BANNER_SPACING", str(int(x.get_value()))))
        col = Gtk.ColorButton(); col.set_rgba(self.rgba(self.b["TMUX_FARBE"]))
        def picked(btn):
            r = btn.get_rgba(); self.b["TMUX_FARBE"] = "#%02x%02x%02x" % (int(r.red * 255), int(r.green * 255), int(r.blue * 255))
        col.connect("color-set", picked)
        logo_col = Gtk.ColorButton(rgba=self.rgba(self.b["LOGO_COLOR"]))
        logo_col.connect("color-set", self.banner_color_changed, "LOGO_COLOR")
        banner_col = Gtk.ColorButton(rgba=self.rgba(self.b["BANNER_COLOR"]))
        banner_col.connect("color-set", self.banner_color_changed, "BANNER_COLOR")
        self.row(g, "Banner beim Start anzeigen", sw("BANNER_AN"))
        self.row(g, "Logo am Anfang", logo)
        self.logo_size_scale = logo_size
        size_box = Gtk.Box(spacing=8)
        logo_size.set_size_request(260, -1)
        size_box.pack_start(logo_size, False, False, 0)
        size_reset = Gtk.Button(label="Zurücksetzen (100 %)")
        size_reset.connect("clicked", lambda _b: logo_size.set_value(100))
        size_box.pack_start(size_reset, False, False, 0)
        self.row(g, "Logo-Größe im Terminal (%)", size_box,
                 "100 % = Originalgröße. Das Logo besteht aus Buchstaben und wird bei anderen Größen unscharf.")
        zoom = self.scale("LogoPreviewSize", 5, 32)
        zoom_box = Gtk.Box(spacing=8)
        zoom.set_size_request(260, -1)
        zoom_box.pack_start(zoom, False, False, 0)
        zoom_reset = Gtk.Button(label="Standard (12)")
        zoom_reset.connect("clicked", lambda _b: zoom.set_value(12))
        zoom_box.pack_start(zoom_reset, False, False, 0)
        self.row(g, "Vorschau-Zoom", zoom_box, "Ändert nur die Vorschau rechts")
        hide = Gtk.Button(label="Ausgewähltes vorinstalliertes Logo entfernen")
        hide.connect("clicked", self.hide_builtin_logo)
        self.row(g, "Logo aus Auswahl entfernen", hide)
