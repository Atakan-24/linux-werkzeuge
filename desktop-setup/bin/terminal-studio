def parse_binding(text):
    """'Escape,1' -> ['Escape', '1'];  'Alt+C' -> ['Alt+C'];  '' -> []"""
    return [part.strip() for part in str(text or "").split(",") if part.strip()]


class SequenceMatcher:
    """Erkennt Tastenfolgen wie 'Escape,1'. Einzeltasten meldet er als 'kein'."""

    def __init__(self, clock=None, window=SEQUENCE_WINDOW):
        self.clock = clock or time.monotonic
        self.window = window
        self.pending = None            # (aktion, index des naechsten Schritts, zeitpunkt)

    def feed(self, key, bindings):
        """-> ('treffer', aktion) | ('wartet', aktion) | ('kein', None)"""
        now = self.clock()
        if self.pending:
            aktion, index, since = self.pending
            self.pending = None
            steps = parse_binding(bindings.get(aktion))
            if now - since <= self.window and index < len(steps) and key == steps[index]:
                if index + 1 == len(steps):
                    return ("treffer", aktion)
                self.pending = (aktion, index + 1, now)
                return ("wartet", aktion)
        for aktion, text in bindings.items():
            steps = parse_binding(text)
            if len(steps) > 1 and key == steps[0]:
                self.pending = (aktion, 1, now)
                return ("wartet", aktion)
        return ("kein", None)


