CUSTOM_LOGO = os.path.join(BANNER_DIR, "logos/custom.txt")
OWN_LOGOS_FILE = os.path.join(BANNER_DIR, "own-logos.json")


def load_own_logos():
    try:
        with open(OWN_LOGOS_FILE) as f:
            data = json.load(f)
        if isinstance(data, list):
            return [item for item in data if isinstance(item, dict) and
                    re.fullmatch(r"[0-9a-f]{32}", str(item.get("id", ""))) and
                    isinstance(item.get("name"), str) and isinstance(item.get("art"), str)]
    except (OSError, ValueError):
        pass
    return []


def logo_art(key):
    if key.startswith("user:"):
        logo_id = key[5:]
        if not re.fullmatch(r"[0-9a-f]{32}", logo_id):
            return ""
        for directory in (BANNER_DIR, "/root/.config/terminal-style"):
            try:
                with open(os.path.join(directory, "logos", "user_" + logo_id + ".txt")) as f:
                    return f.read().rstrip("\n")
            except OSError:
                continue
        return ""
    value = LOGO_ARTS.get(key, LOGO_ARTS["arch"])[1]
    if not value:
        return ""
    path = os.path.join(BANNER_DIR, value)
    shared_path = os.path.join("/root/.config/terminal-style", value)
    try:
        with open(path) as f:
            return f.read().rstrip("\n")
    except OSError:
        try:
            with open(shared_path) as f:
                return f.read().rstrip("\n")
        except OSError:
            return value


def load_custom_logo():
    try:
        with open(CUSTOM_LOGO) as f:
            return f.read().rstrip("\n")
    except OSError:
        return ""


def save_custom_logo(text):
    os.makedirs(os.path.dirname(CUSTOM_LOGO), exist_ok=True)
    with open(CUSTOM_LOGO, "w") as f:
        f.write(text.rstrip("\n") + "\n")


def invert_logo_text(text):
    out = []
    for ch in text:
        code = ord(ch)
        if 0x2800 <= code <= 0x28FF:
            out.append(chr(0x2800 + (0xFF - (code - 0x2800))))
        elif ch == "█":
            out.append(" ")
        elif ch == " ":
            out.append("█")
        elif ch == "#":
            out.append(" ")
        elif ch == ".":
            out.append("█")
        else:
            out.append(ch)
    return "".join(out)


def load_banner():
    """Liest ~/.config/terminal-style/config (Shell-Format KEY=\"wert\")."""
    import shlex
    b = dict(BANNER_DEFAULTS)
    try:
        for line in open(BANNER_CONF):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                if k in b:
                    parts = shlex.split(v)
                    b[k] = parts[0] if parts else ""
    except FileNotFoundError:
        pass
    return b


def save_banner(b):
    import shlex
    os.makedirs(BANNER_DIR, exist_ok=True)
    with open(BANNER_CONF, "w") as f:
        f.write("# Terminal-Style Einstellungen (vom Terminal-Studio geschrieben)\n")
        for k in BANNER_DEFAULTS:
            f.write("%s=%s\n" % (k, shlex.quote(str(b[k]))))
    hexc = b["TMUX_FARBE"]
    with open(os.path.join(BANNER_DIR, "tmux-farbe.conf"), "w") as f:
        f.write('set -g status-left "#[bg=%s,fg=#1e1e2e,bold] #S #[default] "\nset -g pane-active-border-style "fg=%s"\n' % (hexc, hexc))


def figlet_fonts():
    good = ("standard", "slant", "smslant", "small", "mini", "big", "block", "lean", "shadow", "smshadow")
    return [("plain", "Klartext (ohne ASCII-Symbole)")] + [
        (font, font) for font in good if os.path.exists("/usr/share/figlet/" + font + ".flf")]


def squeeze_banner_spacing(text, spacing):
    """Reduziert breite Leerraeume im Start-Banner, ohne Einrueckung komplett zu zerquetschen."""
    try:
        spacing = max(0, min(8, int(spacing)))
    except ValueError:
        spacing = 1
    keep = spacing + 1
    out = []
    for line in text.splitlines():
        prefix_len = len(line) - len(line.lstrip(" "))
        prefix = line[:prefix_len]
        body = line[prefix_len:]
        while " " * (keep + 2) in body:
            body = body.replace(" " * (keep + 2), " " * (keep + 1))
        out.append(prefix + body)
    return "\n".join(out)


def render_banner_text(b, custom_text=None, own_logos=None):
    if b.get("BANNER_AN") != "ja":
        return ""
    parts = []
    if b.get("LOGO_ART") == "custom" and custom_text is not None:
        art = custom_text.rstrip("\n")
    elif b.get("LOGO_ART", "").startswith("user:") and own_logos is not None:
        art = next((item["art"].rstrip("\n") for item in own_logos
                    if "user:" + item["id"] == b["LOGO_ART"]), "")
    else:
        art = logo_art(b.get("LOGO_ART", "arch"))
    if b.get("LOGO_INVERT") == "ja":
        art = invert_logo_text(art)
    art = scale_logo(art, b.get("LOGO_SCALE", "100"))
    if art:
        parts.append(art)
    text = b.get("BANNER_TEXT", "KALI") or "KALI"
    font = b.get("BANNER_SCHRIFT", "slant") or "slant"
    if font == "plain":
        fig = text
    else:
        try:
            fig = subprocess.run(["figlet", "-w", "80", "-f", font, text], capture_output=True, text=True, timeout=2).stdout.rstrip("\n")
        except Exception:
            fig = text
    fig = squeeze_banner_spacing(fig, b.get("BANNER_SPACING", "1"))
    if fig:
        parts.append(fig)
    output = "\n\n".join(parts)
    if b.get("INFO_ZEILE") == "ja":
        user = pwd.getpwuid(os.geteuid()).pw_name
        info = "  %s@%s  |  %s" % (
            user, os.uname().nodename, datetime.datetime.now().strftime("%d.%m.%Y %H:%M"))
        output = output + "\n" + info if output else info
    return output


