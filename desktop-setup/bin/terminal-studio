def default_ansi(custom):
    bg, fg, ac = (hex2rgb(custom[k]) for k in ("bg", "fg", "accent"))
    def mix(a, b, t):
        return tuple(a[i] * (1 - t) + b[i] * t for i in range(3))
    base = [mix(bg, (0, 0, 0), .3), ac, mix(ac, (1, .86, 0), .5),
            mix(ac, (1, 1, 0), .7), mix(ac, (.24, .35, 1), .6),
            mix(ac, (.78, 0, 1), .5), mix(ac, (0, .86, 1), .5), fg]
    bright = [mix(color, (1, 1, 1), .35) for color in base]
    return ["#%02x%02x%02x" % tuple(round(v * 255) for v in color) for color in base + bright]


def load():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONF) as f:
            c.update(json.load(f))
    except Exception:
        pass
    custom = c["custom"]
    custom.setdefault("ansi", default_ansi(custom))
    custom.setdefault("fg_bright", "#ffffff")
    c["studioShortcuts"] = {**DEFAULTS["studioShortcuts"], **c.get("studioShortcuts", {})}
    if c["studioShortcuts"].get("close") in ("Escape", "Escape,1") and not c.get("migratedCirc"):
        c["studioShortcuts"]["close"] = "^,1"           # ^ statt Esc; ^ allein schliesst das Studio nicht
    c["migratedCirc"] = True
    c["migratedEsc1"] = True
    ini = os.path.expanduser("~/.config/qterminal.org/qterminal.ini")
    shortcuts = {}
    try:
        section = False
        for line in open(ini):
            line = line.strip()
            if line.startswith("["):
                section = line == "[Shortcuts]"
            elif section and "=" in line:
                key, value = line.split("=", 1)
                shortcuts[key] = value
    except OSError:
        pass
    saved_shortcuts = c.get("terminalShortcuts", {})
    c["terminalShortcuts"] = {**shortcuts, **saved_shortcuts}
    for key, default in (("Copy%20Selection", "Ctrl+Shift+C"), ("Paste%20Clipboard", "Alt+V")):
        if key not in saved_shortcuts:
            c["terminalShortcuts"][key] = default
    return c


def read_scheme(name):
    """Hintergrund/Vordergrund/Rot aus einer .colorscheme-Datei lesen (für die Vorschau)."""
    cols, sec = {}, None
    try:
        with open(os.path.join(SCHEMES, name + ".colorscheme")) as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    sec = line[1:-1]
                elif line.startswith("Color=") and sec:
                    cols[sec] = tuple(int(x) / 255 for x in line[6:].split(",")[:3])
    except Exception:
        pass
    return cols.get("Background", (0.1, 0.1, 0.1)), cols.get("Foreground", (1, 1, 1)), cols.get("Color1", (0.9, 0.1, 0.1)), cols.get("Color2", (0.4, 0.8, 0.6)), cols.get("Color4", (0.3, 0.5, 1))


def hex2rgb(h):
    h = h.lstrip("#"); return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def mono_fonts():
    out = subprocess.run(["fc-list", ":spacing=mono", "family"], capture_output=True, text=True).stdout
    fams = sorted({l.split(",")[0].strip() for l in out.splitlines() if l.strip() and "Emoji" not in l and "MathJax" not in l and "SignWriting" not in l})
    if "FiraCode" not in fams:
        fams.insert(0, "FiraCode")
    return fams


