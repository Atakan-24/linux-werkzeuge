def load_profiles():
    """{'own': {Name: {'c':{}, 'b':{}}}, 'hidden': [ausgeblendete Vorlagen]}"""
    data = {"own": {}, "hidden": []}
    try:
        with open(PROFILES_FILE) as f:
            raw = json.load(f)
        if isinstance(raw.get("own"), dict):
            data["own"] = {str(k)[:40]: v for k, v in raw["own"].items() if isinstance(v, dict)}
        if isinstance(raw.get("hidden"), list):
            data["hidden"] = [h for h in raw["hidden"] if isinstance(h, str)]
    except (OSError, ValueError, AttributeError):
        pass
    return data


def save_profiles(data):
    os.makedirs(BANNER_DIR, exist_ok=True)
    tmp = PROFILES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, PROFILES_FILE)


def clean_profile_name(text):
    name = " ".join(str(text or "").split())
    return "".join(ch for ch in name if ch.isprintable())[:40].strip()


class Studio(Gtk.Window):
    def __init__(self):
        super().__init__(title="Terminal-Studio")
        try:
            _mon = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
            _geo = _mon.get_geometry()
            self.set_default_size(min(1240, _geo.width - 40), min(720, _geo.height - 160))
        except Exception:
            self.set_default_size(1240, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("terminal-studio")
        self.c = load()
        self.codex_ui = {**json.loads(json.dumps(CODEX_DEFAULTS)), **self.c.get("codex_ui", {})}
        self.codex_ui["custom_colors"] = {**CODEX_DEFAULTS["custom_colors"],
                                          **self.codex_ui.get("custom_colors", {})}
        self.codex_ui["locations"] = {**CODEX_DEFAULTS["locations"],
                                      **self.codex_ui.get("locations", {})}
        self.b = load_banner()
        self.hidden_logos = set(filter(None, self.b.get("HIDDEN_LOGOS", "").split(",")))
        self.own_logos = load_own_logos()
        self.profiles = load_profiles()
        self.building = True
        self.recording_hotkey = None
        self.last_text_focus = None
        self.sequences = SequenceMatcher()
        self.hint_source = None
        self.hotkey_entries = {}
        self.test_entry = None
        self.test_last = None
        self.hotkey_initial = dict(self.c["terminalShortcuts"])

        css = Gtk.CssProvider()
        css.load_from_data(b"""
          window { background: #120404; color: #f0d0d0; }
          notebook header { background: #1c0606; }
          notebook tab label { color: #ff7070; }
          .title { font-size: 20px; font-weight: bold; color: #ff4040; }
          .hint { color: #b08080; font-size: 11px; }
          button.save { background: #a00010; color: white; font-weight: bold; }
          .banner-preview text { background: #090b10; color: #ededed; }
          window.close-pending { border: 5px solid #ff3030; }
          entry.konflikt { border: 2px solid #ff3030; }
        """)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        self.add(root)
        t = Gtk.Label(label="Terminal-Studio", xalign=0); t.get_style_context().add_class("title")
        root.pack_start(t, False, False, 0)

        pres = Gtk.Box(spacing=6)
        pres.pack_start(Gtk.Label(label="Profile:"), False, False, 0)
        self.profile_flow = Gtk.FlowBox()
        self.profile_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.profile_flow.set_homogeneous(False)
        self.profile_flow.set_column_spacing(6)
        self.profile_flow.set_row_spacing(4)
        self.profile_flow.set_max_children_per_line(12)
        self.preset_buttons = []
