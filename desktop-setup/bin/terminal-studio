            group.pack_start(button, False, False, 0)
            self.row(g, label, group)
        for key, label in (("model", "Modell anzeigen"), ("effort", "Nachdenken anzeigen"),
                           ("five", "5-Stunden-Limit anzeigen"), ("week", "Wochenlimit anzeigen"),
                           ("cyber", "Berechtigungsmodus anzeigen")):
            group = Gtk.Box(spacing=8)
