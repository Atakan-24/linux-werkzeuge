        self.row(g, "Fett = hellere Farbe", self.switch("BoldIntense"))
        return g

    def page_colors(self):
        g = self.grid()
        schemes = sorted(n[:-12] for n in os.listdir(SCHEMES) if n.endswith(".colorscheme"))
        if "Eigenes" not in schemes:
            schemes.append("Eigenes")
        self.row(g, "Farbschema", self.combo("colorScheme", [(s, "Eigenes (unten wählen)" if s == "Eigenes" else s) for s in schemes]))
        self.row(g, "Durchsichtigkeit", self.scale("TerminalTransparency", 0, 100), "0 = deckend, 100 = vollständig transparent")
        fully = Gtk.Button(label="Hintergrund ganz transparent machen")
        fully.connect("clicked", self.make_fully_transparent)
        self.row(g, "Schnellauswahl", fully, "Stellt auf 100 und entfernt ein gewähltes Hintergrundbild.")
        self.custom_buttons = {}
        for k, t in (("bg", "Eigenes: Hintergrund"), ("fg", "Eigenes: Ausgabe"),
                     ("fg_bright", "Eigenes: helle Schrift"), ("accent", "Eigenes: Akzent")):
            b = Gtk.ColorButton(rgba=self.rgba(self.c["custom"][k]))
            self.custom_buttons[k] = b
            if k == "fg":
                self.output_color_button = b
            b.connect("color-set", self.custom_color, k); self.row(g, t, b)
        input_btn = Gtk.ColorButton(rgba=self.rgba(self.b["INPUT_COLOR"]))
        self.input_color_button = input_btn
        input_btn.connect("color-set", self.input_color_changed)
        self.row(g, "Dein Text (Zsh-Eingabe)", input_btn,
                 "Freie Farbwahl für Text, den du in der Zsh-Shell tippst")
        self.row(g, "Antworten / Ausgabe: Farbvorlagen", self.color_palette("output"),
                 "Allgemeine Terminal-Ausgabe; Programme können eigene Farben verwenden")
        self.row(g, "Dein Text: Farbvorlagen", self.color_palette("input"),
                 "Weitere Farben über den Farbwähler oben, auch per Hex-Code")
        self.row(g, "Farb-Stile", self.color_styles(),
                 "Ändert Hintergrund, Ausgabe, Eingabe und Akzent gemeinsam")
        heading = Gtk.Label(label="Terminal-Ausgabe: ANSI-Farben einzeln", xalign=0)
        heading.get_style_context().add_class("title")
        g.attach(heading, 0, g.row, 2, 1); g.row += 1
        self.ansi_buttons = []
        for i in range(16):
            button = Gtk.ColorButton(rgba=self.rgba(self.c["custom"]["ansi"][i]))
            button.connect("color-set", self.ansi_color_changed, i)
            self.ansi_buttons.append(button)
            label = ("Hell: " if i >= 8 else "") + ANSI_NAMES[i % 8]
            self.row(g, label, button)
        h = Gtk.Label(label="Eigene Farben wirken, wenn oben „Eigenes“ gewählt ist.", xalign=0)
        h.get_style_context().add_class("hint"); g.attach(h, 1, g.row, 1, 1)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(g)
        return scroll

    def page_background(self):
        g = self.grid()
        cb = Gtk.ComboBoxText()
        cb.append("", "Kein Bild"); cb.append(REDBG_NOLOGO, "Roter Code (ohne Logo)"); cb.append(REDBG, "Roter Code mit Kali-Logo")
        self.add_folder_images(cb, self.c.get("BackgroundImageFolder", ""))
        cb.append("__logo__", "Text-Logo in der Mitte …")
        cb.append("__file__", "Eigenes Bild wählen …")
        cb.append("__folder__", "Eigenen Bilderordner wählen …")
        cur = self.c["TerminalBackgroundImage"]
        if cur not in ("", REDBG, REDBG_NOLOGO):
            cb.append(cur, os.path.basename(cur))
        cb.set_active_id(cur)
        cb.connect("changed", self.bg_changed); self.w["bgimg"] = cb
        self.row(g, "Hintergrundbild", cb, "Tipp: mit Bild die Durchsichtigkeit auf 0 stellen")
        self.row(g, "Bild abdunkeln", self.scale("BackgroundImageDim", 0, 100),
                 "0 = Originalbild, 100 = Bild ausgeblendet; macht Schrift besser lesbar")
        self.row(g, "Bild-Anpassung", self.combo("TerminalBackgroundMode",
                 [(0, "Normal"), (1, "Strecken"), (2, "Zoomen (füllt alles)"), (3, "Einpassen"), (4, "Mittig")]))
        self.row(g, "Rand innen (Pixel)", self.scale("TerminalMargin", 0, 40))
        self.row(g, "Rahmenlos (ohne Titelleiste)", self.switch("Borderless"))
        self.row(g, "Menüleiste anzeigen", self.switch("MenuVisible"), "Wieder einblenden: Strg+Umschalt+M")
        return g

    def add_folder_images(self, cb, folder):
        if not folder or not os.path.isdir(folder):
            return []
        images = []
        try:
            for entry in sorted(os.scandir(folder), key=lambda item: item.name.casefold()):
                if entry.is_file() and entry.name.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")):
                    images.append(entry.path)
        except OSError:
            return []
        for path in images[:200]:
            cb.append(path, "Ordner: " + os.path.basename(path))
        return images[:200]

