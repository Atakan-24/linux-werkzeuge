#!/usr/bin/env python3
"""Screenshot im Mac-Stil.  mac-screenshot [full|region|window|bar]
Speichert nach ~/Schreibtisch UND in die Zwischenablage, zeigt danach eine Vorschau-Kachel unten rechts."""
import gi, os, subprocess, sys, time, shutil
gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

DIR = os.path.expanduser("~/Schreibtisch")
CSS = b"""
window.bar { background: rgba(18,4,4,0.94); border: 1px solid #7a1018; border-radius: 14px; }
window.bar button { background: #2a0a0c; color: #ffb0b0; border: 1px solid #5a1016; border-radius: 8px; padding: 8px 14px; }
window.bar button:hover { background: #e61e28; color: white; }
window.thumb { background: rgba(18,4,4,0.96); border: 2px solid #e61e28; border-radius: 10px; }
window.thumb label { color: #ffb0b0; }
"""

def dest():
    os.makedirs(DIR, exist_ok=True)
    return os.path.join(DIR, time.strftime("Bildschirmfoto_%Y-%m-%d_%H-%M-%S.png"))

def capture(mode, delay=0):
    if delay: time.sleep(delay)
    out = dest()
    if mode == "full":
        r = subprocess.run(["import", "-window", "root", out])
    elif mode == "window":
        r = subprocess.run(["import", out])           # Klick auf ein Fenster
    else:
        r = subprocess.run(["import", out])           # Bereich aufziehen (Ziehen mit Maus)
    if r.returncode != 0 or not os.path.exists(out):
        return None
    subprocess.Popen(["xclip", "-selection", "clipboard", "-t", "image/png", "-i", out],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True) if shutil.which("xclip") else None
    return out

def thumb(path):
    w = Gtk.Window(type=Gtk.WindowType.POPUP); w.get_style_context().add_class("thumb")
    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 260, 160, True)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=8)
    box.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
    box.pack_start(Gtk.Label(label="Gespeichert auf dem Schreibtisch – klicken zum Öffnen"), False, False, 0)
    ev = Gtk.EventBox(); ev.add(box); w.add(ev)
    def click(_w, e):
        if e.button == 1: subprocess.Popen(["ristretto", path], start_new_session=True)
        Gtk.main_quit()
    ev.connect("button-press-event", click)
    w.show_all()
    s = Gdk.Screen.get_default(); ww, hh = w.get_size()
    w.move(s.get_width() - ww - 24, s.get_height() - hh - 90)
    GLib.timeout_add_seconds(5, Gtk.main_quit)
    Gtk.main(); w.destroy()

def init_css():
    c = Gtk.CssProvider(); c.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), c, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

def run(mode, delay=0):
    p = capture(mode, delay)
    if p:
        init_css(); thumb(p)

def bar():
    init_css()
    w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL, title="Screenshot"); w.set_keep_above(True); w.set_decorated(False)
    w.get_style_context().add_class("bar"); w.set_icon_name("mac-screenshot")
    s = Gdk.Screen.get_default()
    box = Gtk.Box(spacing=8, margin=10); w.add(box)
    delay = {"v": 0}
    def go(_b, mode):
        w.hide(); 
        while Gtk.events_pending(): Gtk.main_iteration()
        time.sleep(0.4 + delay["v"])
        p = capture(mode)
        if p: thumb(p)
        Gtk.main_quit()
    for label, mode in [("Ganzer Bildschirm", "full"), ("Fenster", "window"), ("Bereich", "region")]:
        b = Gtk.Button(label=label); b.connect("clicked", go, mode); box.pack_start(b, False, False, 0)
    dl = Gtk.ComboBoxText()
    for v, t in [(0, "sofort"), (5, "5 s"), (10, "10 s")]: dl.append(str(v), t)
    dl.set_active_id("0"); dl.connect("changed", lambda c: delay.__setitem__("v", int(c.get_active_id())))
    box.pack_start(dl, False, False, 0)
    x = Gtk.Button(label="✕"); x.connect("clicked", lambda _b: Gtk.main_quit()); box.pack_start(x, False, False, 0)
    w.connect("key-press-event", lambda _w, e: Gtk.main_quit() if e.keyval == Gdk.KEY_Escape else None)
    w.show_all(); ww, hh = w.get_size(); w.move((s.get_width() - ww) // 2, s.get_height() - hh - 110)
    Gtk.main()

if __name__ == "__main__":
    m = sys.argv[1] if len(sys.argv) > 1 else "bar"
    bar() if m == "bar" else run(m)
